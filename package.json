{
  "name": "fontferry",
  "version": "0.2.0-alpha.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "test": "vitest run --config ui/vitest.config.ts",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config apps/fontferry/src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config apps/fontferry/src-tauri/tauri.conf.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
