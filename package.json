{
  "name": "fontferry",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "test": "vitest run --config ui/vitest.config.ts",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config apps/fontferry/src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config apps/fontferry/src-tauri/tauri.conf.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  }
}
