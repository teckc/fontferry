{
  "id": "maple-mono",
  "name": "Maple Mono",
  "description": "圆角等宽字体，提供 NF、CN、连字和 hinted 等多种发行变体。",
  "homepage": "https://github.com/subframe7536/maple-font",
  "license": {
    "name": "SIL Open Font License 1.1",
    "spdx": "OFL-1.1",
    "url": "https://github.com/subframe7536/maple-font/blob/variable/OFL.txt",
    "redistribution": true,
    "requiresAcceptance": false
  },
  "source": {
    "type": "GitHubRelease",
    "repository": "subframe7536/maple-font",
    "channel": "Stable"
  },
  "presets": [
    {
      "id": "nf-cn",
      "name": "Maple Mono NF CN",
      "description": "连字、Nerd Font 图标和中日韩字符，适合终端与编辑器。",
      "assetPattern": "^MapleMono-NF-CN\\.zip$",
      "default": true
    },
    {
      "id": "nf-cn-unhinted",
      "name": "Maple Mono NF CN Unhinted",
      "assetPattern": "^MapleMono-NF-CN-unhinted\\.zip$",
      "default": false
    },
    {
      "id": "normal-nf-cn",
      "name": "Maple Mono Normal NF CN",
      "assetPattern": "^MapleMonoNormal-NF-CN\\.zip$",
      "default": false
    },
    {
      "id": "ttf",
      "name": "Maple Mono TTF",
      "assetPattern": "^MapleMono-TTF\\.zip$",
      "default": false
    },
    {
      "id": "ttf-autohint",
      "name": "Maple Mono TTF AutoHint",
      "assetPattern": "^MapleMono-TTF-AutoHint\\.zip$",
      "default": false
    }
  ]
}

