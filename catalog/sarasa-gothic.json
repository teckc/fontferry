{
  "id": "sarasa-gothic",
  "name": "更纱黑体",
  "description": "面向编程与界面的 CJK 字体家族；默认选择简体中文 Gothic TTF 7z 包。",
  "homepage": "https://github.com/be5invis/Sarasa-Gothic",
  "license": {
    "name": "SIL Open Font License 1.1",
    "spdx": "OFL-1.1",
    "url": "https://github.com/be5invis/Sarasa-Gothic/blob/main/LICENSE",
    "redistribution": true,
    "requiresAcceptance": false
  },
  "source": {
    "type": "GitHubRelease",
    "repository": "be5invis/Sarasa-Gothic",
    "channel": "Stable"
  },
  "presets": [
    {
      "id": "gothic-sc",
      "name": "Gothic SC TTF",
      "assetPattern": "^SarasaGothicSC-TTF-[0-9.]+\\.7z$",
      "default": true
    },
    {
      "id": "mono-sc",
      "name": "Mono SC TTF",
      "assetPattern": "^SarasaMonoSC-TTF-[0-9.]+\\.7z$",
      "default": false
    },
    {
      "id": "term-sc",
      "name": "Term SC TTF",
      "assetPattern": "^SarasaTermSC-TTF-[0-9.]+\\.7z$",
      "default": false
    },
    {
      "id": "fixed-sc",
      "name": "Fixed SC TTF",
      "assetPattern": "^SarasaFixedSC-TTF-[0-9.]+\\.7z$",
      "default": false
    }
  ]
}

